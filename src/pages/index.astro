---
import { getArticles } from "../lib/notion.js";

// Notionからお知らせとコラムを取得
const oshirase = await getArticles("お知らせ");
const columns = await getArticles("コラム");

// 日付を「2026.09.01」形式に整える関数
function formatDate(dateStr) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}.${m}.${day}`;
}

// デフォルトのサムネイル画像
const defaultThumb = "images/kv.jpg";
