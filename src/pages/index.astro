<style>
  :root{
    --pink:#ED1E78;
    --pink-soft:#F9D5E4;
    --pink-pale:#FDF0F5;
    --ink:#2B2B2B;
    --ink-soft:#5A5A5A;
    --paper:#FFFFFF;
    --greige:#F5F2EF;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  section[id]{scroll-margin-top:80px;}
  body{
    font-family:"Hiragino Maru Gothic ProN","Hiragino Sans","Yu Gothic",system-ui,sans-serif;
    color:var(--ink);
    line-height:1.9;
    background:var(--paper);
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;}

  /* 見出し共通 */
  .eyebrow{
    display:inline-block;
    font-size:.78rem;
    letter-spacing:.18em;
    color:var(--pink);
    font-weight:700;
    margin-bottom:.6em;
  }
  .section-title{
    font-size:clamp(1.5rem,5vw,2.1rem);
    font-weight:800;
    color:var(--pink);
    line-height:1.4;
    margin-bottom:.2em;
  }
  .section-title-en{
    font-size:clamp(1rem,3.5vw,1.3rem);
    color:#C9C2BE;
    font-weight:800;
    letter-spacing:.02em;
    margin-bottom:1.4em;
  }

  section{padding:clamp(3rem,9vw,5.5rem) 1.4rem;}
  .wrap{max-width:760px;margin:0 auto;}

  /* ===== ヘッダー ===== */
  .site-header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--pink-soft);
    padding:1.05rem 1.2rem;
    display:flex;align-items:center;justify-content:space-between;
  }
  .site-header .logo{font-weight:800;color:var(--pink);font-size:1.05rem;letter-spacing:.02em;display:flex;align-items:center;gap:.6rem;}
  .site-header .logo-img{height:52px;width:auto;}
  .site-header .logo span{font-size:.7rem;color:var(--ink-soft);display:block;font-weight:600;letter-spacing:.06em;}
  .header-cta{
    background:var(--pink);color:#fff;text-decoration:none;
    padding:.5rem 1rem;border-radius:999px;font-size:.85rem;font-weight:700;
    white-space:nowrap;
  }

  /* ナビゲーション */
  .site-nav{display:flex;align-items:center;gap:.3rem;}
  .site-nav a{
    text-decoration:none;color:var(--ink);font-size:.9rem;font-weight:700;
    padding:.5rem .7rem;border-radius:8px;white-space:nowrap;
    transition:color .15s ease,background .15s ease;
  }
  .site-nav a:hover{color:var(--pink);background:var(--pink-pale);}
  .site-nav a.nav-cta{
    background:var(--pink);color:#fff;margin-left:.4rem;
    padding:.5rem 1.1rem;border-radius:999px;
  }
  .site-nav a.nav-cta:hover{background:#d11268;color:#fff;}

  /* ハンバーガーボタン（スマホのみ表示） */
  .nav-toggle{
    display:none;flex-direction:column;gap:5px;
    background:none;border:none;cursor:pointer;padding:.4rem;z-index:60;
  }
  .nav-toggle span{
    display:block;width:26px;height:3px;border-radius:2px;
    background:var(--pink);transition:transform .25s ease,opacity .2s ease;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(8px) rotate(45deg);}
  .nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0;}
  .nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-8px) rotate(-45deg);}

  /* タブレット以下：ナビを折りたたむ */
  @media(max-width:900px){
    .nav-toggle{display:flex;}
    .site-nav{
      position:fixed;top:0;right:0;height:100vh;width:min(78vw,320px);
      flex-direction:column;align-items:stretch;justify-content:flex-start;
      gap:0;padding:5.5rem 1.4rem 2rem;
      background:#fff;box-shadow:-8px 0 30px rgba(0,0,0,.12);
      transform:translateX(100%);transition:transform .3s ease;
      overflow-y:auto;
    }
    .site-nav.open{transform:translateX(0);}
    .site-nav a{
      padding:1rem .5rem;border-bottom:1px solid var(--pink-pale);
      font-size:1rem;border-radius:0;
    }
    .site-nav a.nav-cta{
      margin:1rem 0 0;text-align:center;border-radius:999px;border-bottom:none;
    }
    /* 背景オーバーレイ */
    .nav-overlay{
      position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:40;
      opacity:0;visibility:hidden;transition:opacity .3s ease;
    }
    .nav-overlay.open{opacity:1;visibility:visible;}
  }

  /* ===== ヒーロー（全面背景） ===== */
  .hero{
    position:relative;
    min-height:min(88vh,720px);
    display:flex;align-items:flex-end;
    padding:clamp(2rem,6vw,4rem) 1.4rem clamp(2.5rem,7vw,4rem);
    background-image:linear-gradient(180deg,rgba(0,0,0,.05) 0%,rgba(0,0,0,.15) 45%,rgba(0,0,0,.55) 100%),url("/images/kv.jpg");
    background-size:cover;
    background-position:center 30%;
    overflow:hidden;
  }
  .hero-inner{
    position:relative;z-index:2;
    max-width:1080px;margin:0 auto;width:100%;
  }
  .hero-copy{max-width:620px;}
  .hero-logo{
    height:56px;width:auto;margin-bottom:1.3rem;
    background:rgba(255,255,255,.92);padding:.5rem .8rem;border-radius:12px;
  }
  .hero h1{
    font-size:clamp(1.7rem,6vw,3rem);
    font-weight:800;
    line-height:1.4;
    margin-bottom:.6em;
    color:#fff;
    text-shadow:0 2px 12px rgba(0,0,0,.35);
  }
  .hero h1 .l{display:block;}
  .hero h1 em{
    color:#fff;font-style:normal;
  }
  .hero .lead{
    font-size:clamp(.95rem,3.5vw,1.15rem);
    color:#fff;
    margin-bottom:1.4em;
    text-shadow:0 1px 8px rgba(0,0,0,.4);
  }
  .hero .tags{
    display:flex;flex-wrap:wrap;gap:.5rem;
    margin-bottom:1.8em;
  }
  .hero .tags span{
    background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.55);
    color:#fff;font-size:.82rem;font-weight:700;
    padding:.35rem .9rem;border-radius:999px;
    backdrop-filter:blur(4px);
  }
  .btn-line{
    display:inline-flex;align-items:center;gap:.5em;
    background:var(--pink);color:#fff;text-decoration:none;
    font-weight:800;font-size:1.05rem;
    padding:.95rem 2.2rem;border-radius:999px;
    box-shadow:0 8px 22px rgba(237,30,120,.28);
    transition:transform .15s ease,box-shadow .15s ease;
  }
  .btn-line:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(237,30,120,.35);}
  .btn-line small{display:block;font-size:.7rem;font-weight:600;opacity:.9;}

  /* ===== お知らせ ===== */
  .news{background:#fff;}
  .news-item{
    display:grid;grid-template-columns:auto 1fr;gap:.3rem 1.6rem;
    padding:1.5rem 0;border-bottom:1px solid #E5E0DC;
  }
  @media(max-width:520px){.news-item{grid-template-columns:1fr;gap:.4rem;}}
  .news-item time{
    font-size:.8rem;color:var(--ink-soft);font-weight:700;
    letter-spacing:.08em;padding-top:.25em;font-variant-numeric:tabular-nums;
  }
  .news-item .news-body h3{font-size:1.08rem;margin-bottom:.4em;font-weight:800;line-height:1.5;}
  .news-item .news-body p{font-size:.9rem;color:var(--ink-soft);}
  .news-item .tag{
    display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.05em;
    color:var(--pink);border:1px solid var(--pink);border-radius:3px;
    padding:.1em .5em;margin-bottom:.5em;
  }

  /* ===== 特徴 ===== */
  .features .feature{
    display:flex;gap:1.2rem;align-items:flex-start;
    padding:1.6rem 0;border-bottom:1px dashed var(--pink-soft);
  }
  .features .feature:last-child{border-bottom:none;}
  .feature .icon{
    flex-shrink:0;width:56px;height:56px;border-radius:50%;
    background:var(--pink-pale);display:grid;place-items:center;
  }
  .feature .icon svg{width:34px;height:34px;}
  .feature h3{font-size:1.15rem;color:var(--pink);font-weight:800;margin-bottom:.3em;}
  .feature p{font-size:.94rem;color:var(--ink-soft);}
  .feature .example{
    display:inline-block;margin-top:.6em;font-size:.85rem;
    background:var(--greige);padding:.5em .9em;border-radius:10px;color:var(--ink);
  }

  /* ===== クラス情報 ===== */
  .classes{background:var(--greige);}
  .class-list{border-top:2px solid var(--ink);}
  .class-row{
    padding:2rem 0;border-bottom:1px solid #DAD4CF;
  }
  .class-row .label{
    display:flex;align-items:baseline;gap:.6rem;margin-bottom:1rem;flex-wrap:wrap;
  }
  .class-row .label .en{
    font-size:1.6rem;font-weight:800;letter-spacing:.01em;
  }
  .class-row.baby .label .en{color:#E56AA0;}
  .class-row.kids .label .en{color:var(--pink);}
  .class-row .label .who{font-size:.82rem;color:var(--ink-soft);font-weight:700;}
  .class-row .detail{
    display:grid;grid-template-columns:auto 1fr;gap:.55em 1.4em;font-size:.95rem;
  }
  .class-row dt{color:var(--ink-soft);font-weight:700;white-space:nowrap;}
  .class-row dd{color:var(--ink);}
  .class-row .fee-num{font-size:1.15rem;font-weight:800;}
  .class-row .fee-num small{font-size:.78rem;color:var(--ink-soft);font-weight:600;margin-left:.3em;}
  .class-note{
    text-align:center;font-size:.92rem;color:var(--ink-soft);margin-top:1.8rem;
  }

  /* ===== 保護者の声 ===== */
  .voices{background:#fff;}
  .voice-card{
    background:var(--pink-pale);border-radius:18px;
    padding:1.6rem 1.6rem 1.6rem;margin-bottom:1.2rem;position:relative;
  }
  .voice-card::before{
    content:"\201C";position:absolute;top:.1em;left:.35em;
    font-size:3rem;color:var(--pink-soft);font-family:Georgia,serif;line-height:1;
  }
  .voice-card p{font-size:.94rem;position:relative;padding-top:.6em;}
  .voice-card .who{margin-top:.8em;font-size:.8rem;color:var(--pink);font-weight:700;}

  /* ===== 講師紹介 ===== */
  .instructors{background:var(--pink-pale);}
  .inst-grid{display:grid;gap:1.6rem;}
  @media(min-width:620px){.inst-grid{grid-template-columns:1fr 1fr;}}
  .inst-card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 6px 20px rgba(237,30,120,.08);}
  .inst-card .photo{aspect-ratio:3/4;background:var(--greige);display:grid;place-items:center;color:#B9B9B9;font-size:.85rem;}
  .inst-card .photo img{width:100%;height:100%;object-fit:cover;}
  .inst-card .body{padding:1.4rem 1.4rem 1.6rem;}
  .inst-card h3{font-size:1.3rem;font-weight:800;margin-bottom:.5em;}
  .inst-card p{font-size:.9rem;color:var(--ink-soft);}

  /* ===== ギャラリー ===== */
  .gallery{background:#fff;}
  .gallery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem;}
  @media(min-width:620px){.gallery-grid{grid-template-columns:repeat(3,1fr);}}
  .gallery-grid .ph{
    aspect-ratio:1/1;background:var(--greige);border-radius:12px;
    display:grid;place-items:center;color:#B9B9B9;font-size:.78rem;overflow:hidden;
  }
  .gallery-grid .ph img{width:100%;height:100%;object-fit:cover;}

  /* ===== コラム一覧 ===== */
  .columns{background:#fff;}
  .column-grid{
    display:grid;gap:1.6rem;grid-template-columns:1fr;
  }
  @media(min-width:640px){.column-grid{grid-template-columns:1fr 1fr;}}
  @media(min-width:900px){.column-grid{grid-template-columns:1fr 1fr 1fr;}}
  .column-card{
    display:block;text-decoration:none;color:inherit;
    border:1px solid var(--pink-soft);border-radius:16px;overflow:hidden;
    transition:transform .15s ease,box-shadow .15s ease;background:#fff;
  }
  .column-card:hover{transform:translateY(-3px);box-shadow:0 10px 28px rgba(237,30,120,.12);}
  .column-card .thumb{aspect-ratio:16/10;overflow:hidden;background:var(--greige);}
  .column-card .thumb img{width:100%;height:100%;object-fit:cover;}
  .column-card .body{padding:1.1rem 1.2rem 1.3rem;}
  .column-card time{font-size:.75rem;color:var(--pink);font-weight:700;letter-spacing:.05em;}
  .column-card h3{font-size:1.02rem;font-weight:800;margin:.3em 0 .5em;line-height:1.5;}
  .column-card p{font-size:.85rem;color:var(--ink-soft);line-height:1.7;}

  /* ===== Instagram誘導 ===== */
  .insta{
    background:linear-gradient(135deg,#F9D5E4 0%,#FDE8D6 100%);
    text-align:center;
  }
  .insta .insta-icon{
    width:60px;height:60px;margin:0 auto 1rem;
    display:grid;place-items:center;
    background:#fff;border-radius:18px;
    box-shadow:0 6px 18px rgba(237,30,120,.15);
  }
  .insta .insta-icon svg{width:34px;height:34px;}
  .insta h2{font-size:clamp(1.4rem,5vw,2rem);font-weight:800;color:var(--ink);margin-bottom:.4em;line-height:1.5;}
  .insta p{font-size:1rem;color:var(--ink-soft);margin-bottom:1.6em;}
  .insta .handle{color:var(--pink);font-weight:800;}
  .btn-insta{
    display:inline-flex;align-items:center;gap:.6em;
    background:linear-gradient(135deg,#F58529,#DD2A7B 50%,#8134AF);
    color:#fff;text-decoration:none;font-weight:800;font-size:1.05rem;
    padding:.9rem 2rem;border-radius:999px;
    box-shadow:0 8px 22px rgba(221,42,123,.3);
    transition:transform .15s ease,box-shadow .15s ease;
  }
  .btn-insta:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(221,42,123,.4);}
  .btn-insta svg{width:22px;height:22px;}
  .access dl{display:grid;grid-template-columns:auto 1fr;gap:.7em 1.2em;font-size:.95rem;max-width:520px;}
  .access dt{color:var(--pink);font-weight:700;white-space:nowrap;}

  /* ===== FAQ ===== */
  .faq details{
    background:#fff;border:1px solid var(--pink-soft);border-radius:14px;
    padding:0 1.3rem;margin-bottom:.8rem;overflow:hidden;
  }
  .faq summary{
    font-weight:700;font-size:1rem;cursor:pointer;
    padding:1.1rem 0;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1em;
  }
  .faq summary::-webkit-details-marker{display:none;}
  .faq summary::after{content:"＋";color:var(--pink);font-weight:800;flex-shrink:0;}
  .faq details[open] summary::after{content:"−";}
